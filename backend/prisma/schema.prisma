generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// * [ENUMS]
enum Role {
  ADMIN
  CASHIER
}

enum InventoryType {
  STOCK_IN
  STOCK_OUT
}

enum TransactionStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  GCASH
}

// * [MODELS]
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(CASHIER)
  isActive  Boolean   @default(true)
  
  // ? Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ? Relations
  cashier   Cashier?
  admin     Admin?

  // ? Item relations
  itemsCreated Item[]  @relation("ItemsCreated")
  itemsUpdated Item[]  @relation("ItemsUpdated")

  // ? InventoryLog relation
  inventoryLogsCreated InventoryLog[] @relation("InventoryLogCreatedBy")
}

model Cashier {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // ? Transaction relation
  transactions Transaction[]
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  // ? Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  // ? Subcategory relation
  subcategories Subcategory[]

  // ? Item relation
  items       Item[]
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)

  // ? Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ? Category relation
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])

  // ? Item relation
  items       Item[]

  // ? Composite key
  @@unique([name, categoryId])
}

model Item {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  sku         String?   @unique
  barcode     String?   @unique
  price       Float
  cost        Float?
  quantity    Int       @default(0)
  unit        String?
  reorderLevel Int?     @default(0)
  isActive     Boolean  @default(true)

  // ? Category relation
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  // ? Subcategory relation
  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  // ? Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int?
  createdBy   User?     @relation("ItemsCreated", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User?     @relation("ItemsUpdated", fields: [updatedById], references: [id])

  // ? Relations
  inventoryLogs   InventoryLog[]
  transactionItems TransactionItem[]
  inventoryReports InventoryReport[]
}

model InventoryLog {
  id        Int       @id @default(autoincrement())
  itemId    Int
  item      Item      @relation(fields: [itemId], references: [id])
  type      InventoryType
  quantity  Int
  isActive  Boolean   @default(true)

  // ? Metadata
  createdAt DateTime  @default(now())
  createdById Int?
  createdBy User?     @relation("InventoryLogCreatedBy", fields: [createdById], references: [id])
}

model Transaction {
  id            Int       @id @default(autoincrement())

  receiptNumber String    @unique

  cashierId     Int
  cashier       Cashier   @relation(fields: [cashierId], references: [id])

  totalAmount   Float
  discount      Float?    @default(0)

  vatInclusive  Boolean?                  // true = price includes VAT, false = price excludes VAT
  vatRate       Float?    @default(0.12)  // 12% VAT rate, can be null if non-VAT
  vatAmount     Float?    @default(0)     // Amount of VAT in the transaction
  grandTotal    Float?                    // totalAmount + vatAmount - discount

  taxRate Float? @default(0.03)           // for 3% percentage tax
  taxAmount Float? @default(0)
  isReported Boolean? @default(true)      // if sale is reported

  cashReceived  Float
  changeGiven   Float

  paymentMethod PaymentMethod @default(CASH)
  status        TransactionStatus @default(COMPLETED)

  isActive      Boolean   @default(true)

  // ? Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ? Item relation
  items         TransactionItem[]
}

model TransactionItem {
  id            Int     @id @default(autoincrement())

  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  itemId        Int
  item          Item    @relation(fields: [itemId], references: [id])

  // ? Snapshot (preserves history even if item changes)
  itemName      String
  priceAtSale   Float
  costAtSale    Float?

  quantity      Int
  subtotal      Float
}

model SalesReport {
  id        Int      @id @default(autoincrement())
  date      DateTime                                  // report date (e.g. daily, weekly, monthly)
  totalSales Float                                    // total sales for a period
  totalProfit Float                                   // total profit (revenue - cost)
  totalTransactions Int                               // number of transactions

  // ? Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryReport {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id])
  currentStock Int
  stockIn     Int
  stockOut    Int

  // ? Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}